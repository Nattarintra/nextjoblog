# Runtime configuration for signup/login. Copy to .env.local for local
# development; set the same names (with hosted values) in Vercel Production.
# Never commit real values to this file.

# Public Supabase project URL. Must be a valid http(s) URL.
# Local: the URL printed by `supabase status` (http://127.0.0.1:54321).
# Production: the hosted Supabase project's URL, set in Vercel Production.
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon/publishable key. Safe to expose to the browser;
# access is still governed by the database's RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin the app is served from. Used for auth redirect construction.
NEXT_PUBLIC_SITE_URL=

# --- Test-only variables (used by the E2E suite; do not set in Vercel Production) ---

# Service-role key for the LOCAL Supabase project only. Used by
# e2e/*.spec.ts to seed users and verify RLS via the Supabase Admin API.
# scripts/run-e2e.mjs reads this from `supabase status`, not from this file.
# A production service-role key must never be set as an application
# environment variable or committed anywhere in this repository.
SUPABASE_SERVICE_ROLE_KEY=
